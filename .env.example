APP_NAME=Nexus AI
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
# Em produção prefira AUTO_CREATE_TABLES=false e rode `alembic upgrade head`.
AUTO_CREATE_TABLES=true

POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql://nexus:change_me@localhost:5432/nexus

REDIS_URL=redis://localhost:6379/0

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

EXECUTION_MODE=inline
EXECUTION_TIMEOUT_SECONDS=300
EXECUTION_MAX_STEPS=200
EXECUTION_MAX_OUTPUT_BYTES=262144
NODE_DEFAULT_MAX_ATTEMPTS=1
MAX_ACTIVE_EXECUTIONS_PER_WORKFLOW=1

HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RESPONSE_BYTES=1000000
HTTP_ALLOW_PRIVATE_NETWORKS=false

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
WEBHOOK_BASE_URL=http://localhost:8000
WEBHOOK_RATE_LIMIT_PER_MINUTE=60
WEBHOOK_MAX_BODY_BYTES=262144
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20

AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1
AI_AGENT_MAX_ITERATIONS=5
AI_REQUEST_TIMEOUT_SECONDS=90
AI_DAILY_TOKEN_LIMIT=200000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@nexus.local
SMTP_USE_TLS=true
